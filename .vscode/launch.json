{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Site in Chrome (starts backend and frontend)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "Start everything",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Frontend only in Chrome",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "Frontend: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Backend (debug)",
      "type": "java",
      "request": "launch",
      "mainClass": "com.denizhankalkan.site.SiteApplication",
      "projectName": "site",
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
